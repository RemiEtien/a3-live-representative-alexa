# Alexa+ simulator: the LLM that plays Alexa (Gemini Flash, function calling)
GEMINI_API_KEY=
# Alexa's voice in the simulator (optional; without it the browser voice is used)
ELEVENLABS_API_KEY=

PORT=3401
# Public base URL of this server, used in MCP Apps CSP and view URLs
PUBLIC_URL=http://localhost:3401

# Public deployment: hides the diagnostic probe, limits live conversations and simulator usage
PUBLIC_MODE=0
MAX_LIVE_SESSIONS=0
MAX_LIVE_SECONDS=0
SIM_TURNS_PER_MIN=0
SIM_TURNS_PER_DAY=0
SIM_TTS_PER_MIN=0
SIM_TTS_CHARS_PER_DAY=0
